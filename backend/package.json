{
  "name": "kamban-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Backend KAMBAN: PocketBase + hooks JS (API /api/v1)",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/**/*.test.js\"",
    "test:all": "npm run test && npm run test:api",
    "coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "lint": "eslint .",
    "create-admin": "node scripts/create-admin.js",
    "demo": "node scripts/demo.js",
    "load": "node scripts/load-test.js",
    "load:docs": "node scripts/load-docs.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
